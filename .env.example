# Copy to .env.local for local dev. NEVER commit real secrets.
# Database (PostgreSQL). Local dev: docker compose up -d db, or a managed Postgres.
DATABASE_URL="postgresql://reeat:reeat@localhost:5432/reeat?schema=public"
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string"
# Thawani Pay — SANDBOX ONLY until the four §11 payment gates in Admin are passed.
# Live keys go in the hosting platform's secret store, never in code.
THAWANI_MODE="sandbox"
THAWANI_API_KEY=""
THAWANI_PUBLISHABLE_KEY=""
THAWANI_WEBHOOK_SECRET=""
THAWANI_API_URL="https://uatcheckout.thawani.om/api/v1"
# Email (transactional, e.g. Resend / SendGrid) — optional in the pilot; codes are
# logged to the server console when no provider is configured. Never log codes in production.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="ReEat Team <hello@reeat.om>"
